const VARIANT_LABELS_ = { announce: 'ประกาศวันเปิด', bao: 'โปร Bao Cafe', custom: 'กำหนดเอง (ส่งต่อ MKT)' };
// เลือกไซส์ป้ายแยกต่อป้าย (unit) ได้แล้ว จุดเดียวกันมีคนละไซส์ได้ — รวมชื่อไซส์ที่ต่างกันในจุดเดียวกันมาต่อกันด้วย " + "
function pointTypeLabel_(units) {
  var seen = {}, list = [];
  (units || []).forEach(function (u) {
    var tk = u.typeKey || 'guerrilla';
    var lbl = SIGNAGE_LABELS_[tk] || tk;
    if (!seen[lbl]) { seen[lbl] = true; list.push(lbl); }
  });
  return list.length ? list.join(' + ') : SIGNAGE_LABELS_.guerrilla;
}
const ARROW_LABELS_ = {
  right: 'เลี้ยวขวา', left: 'เลี้ยวซ้าย', up: 'ตรงไป',
  up_right: 'ตรงไปแล้วเลี้ยวขวา', up_left: 'ตรงไปแล้วเลี้ยวซ้าย',
  arrive_right: 'ถึงแล้ว อยู่ขวามือ', arrive_left: 'ถึงแล้ว อยู่ซ้ายมือ',
  uturn: 'กลับรถ', none: 'ไม่ใส่ลูกศร (ใช้จุดสังเกต)'
};

function fmtShort_(dateStr) {
  if (!dateStr) return '-';
  var parts = String(dateStr).split('-');
  if (parts.length < 3) return String(dateStr);
  var y = parseInt(parts[0], 10), m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
  var months = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
  if (!m || m < 1 || m > 12 || !d) return String(dateStr);
  return d + ' ' + months[m - 1] + ' ' + (y + 543);
}

function chrome_(slide, pageLabel, logoBlob) {
  addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 0, 0, PPTX_SLIDE_W, PPTX_BAR_H, { fill: PPTX_GOLD_BAR });
  addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 0, PPTX_SLIDE_H - PPTX_BAR_H, PPTX_SLIDE_W, PPTX_BAR_H, { fill: PPTX_GOLD_BAR });
  slide.insertImage(logoBlob, pptxIn_(9.27), pptxIn_(0.07), pptxIn_(0.65), pptxIn_(0.56));
  if (pageLabel) {
    var tb = slide.insertTextBox(pageLabel, pptxIn_(8.6), pptxIn_(PPTX_SLIDE_H - 0.32), pptxIn_(1.0), pptxIn_(0.22));
    styleTextBox_(tb, { fontSize: 8, color: '#7A756C', align: SlidesApp.ParagraphAlignment.END, fontFace: PPTX_FONT });
  }
}

function title_(slide, text, size) {
  var tb = slide.insertTextBox(text, pptxIn_(0.34), pptxIn_(0.24), pptxIn_(8.7), pptxIn_(0.45));
  styleTextBox_(tb, { fontSize: size || 20, bold: true, color: PPTX_BLACK, fontFace: PPTX_FONT });
}

function placeholder_(slide, x, y, w, h, label) {
  addShape_(slide, SlidesApp.ShapeType.RECTANGLE, x, y, w, h, { fill: '#F5F2ED', borderColor: '#DDD6C8', borderWeight: 1, dash: true });
  var tb = slide.insertTextBox(label, pptxIn_(x), pptxIn_(y), pptxIn_(w), pptxIn_(h));
  styleTextBox_(tb, { fontSize: 10, color: '#7A756C', italic: true, fontFace: PPTX_FONT, align: SlidesApp.ParagraphAlignment.CENTER, valign: SlidesApp.ContentAlignment.MIDDLE });
}

function goldCard_(slide, x, y, w, h, heading, lines, fontSize) {
  fontSize = fontSize || 10;
  addShape_(slide, SlidesApp.ShapeType.ROUND_RECTANGLE, x, y, w, h, { fill: PPTX_GOLD_BOX, borderColor: PPTX_WHITE, borderWeight: 1.5 });
  var tb = slide.insertTextBox('', pptxIn_(x + 0.14), pptxIn_(y + 0.1), pptxIn_(w - 0.28), pptxIn_(h - 0.2));
  var paragraphs = [[{ text: heading, bold: true, fontSize: fontSize + 2 }]];
  (lines || []).forEach(function (l) { paragraphs.push([{ text: String(l), fontSize: fontSize }]); });
  setRichText_(tb, paragraphs, { color: PPTX_WHITE, fontFace: PPTX_FONT });
  tb.setContentAlignment(SlidesApp.ContentAlignment.TOP);
}

function dataUrlToBlob_(dataUrl) {
  var m = /^data:([^;]+);base64,([\s\S]*)$/.exec(dataUrl || '');
  if (!m) return null;
  try { return Utilities.newBlob(Utilities.base64Decode(m[2]), m[1]); } catch (e) { return null; }
}

// จุดพิกัดสำหรับแสดงในสไลด์ (ป้าย/โรงแรม/ที่จอดรถ) — ใช้ obj.lat/obj.lng (ตัวเลขที่ฝั่งเว็บแยกไว้ให้แล้วอย่างถูกต้อง)
// เป็นหลักก่อนเสมอ แทนที่จะพยายามงมตัวเลขออกมาจากข้อความดิบ (obj.coords) ซึ่งเป็นสาเหตุที่พิกัดเพี้ยน/มั่ว
// ได้ในอดีต — ถ้าใครวางข้อความที่แยกพิกัดไม่ออก (เช่น ลิงก์ย่อ หรือมีข้อความอื่นปนมา) ตัวเลขที่ไม่เกี่ยวข้องกันเลย
// ในสตริงนั้นอาจถูกจับมาแสดงเป็น "พิกัด" อย่างมั่นใจทั้งที่ผิด จึงต้อง fallback แบบเข้มงวด (ต้องเป็นคู่ lat,lng
// ล้วนๆ เท่านั้น) และถ้าแยกไม่ได้จริงๆ ให้โชว์ข้อความดิบแทนการเดาตัวเลขผิดๆ
// สร้างแถวตาราง 1 แถวต่อ 1 ป้าย สำหรับสไลด์ของแต่ละจุดติดป้าย (แทนการ์ดทองข้อความยาวๆ แบบเดิม)
// คอลัมน์: ป้ายที่ / รูปแบบ / ทิศทาง-ระยะ / ข้อความบอกทาง / พิกัด — ตามที่ทีมขอ (ฟีดแบครอบ ก.ย. 2569)
function buildUnitTableRow_(u, uIdx) {
  // ทิศทาง/ลูกศร: ทุกรูปแบบ (announce/bao/custom) จะมีก็ต่อเมื่อเปิดสวิตช์แนบระยะทาง+ลูกศรลงอาร์ตเวิร์ก (u.showDistance)
  var arrowApplies = (u.variant === 'announce' || u.variant === 'bao' || u.variant === 'custom') && u.showDistance;
  var dirCell;
  if (arrowApplies && u.arrow) {
    if (u.arrow === 'none') {
      dirCell = ARROW_LABELS_.none + (u.landmark ? ' (' + u.landmark + ')' : '');
    } else {
      var distText = (u.distance && String(u.arrow).indexOf('arrive') !== 0) ? (' อีก ' + u.distance + ' ' + (u.unit || 'กม.')) : '';
      dirCell = (ARROW_LABELS_[u.arrow] || u.arrow) + distText;
    }
  } else {
    // ไม่มีลูกศร (ยังไม่เปิดสวิตช์ หรือเป็น 'ไม่ใส่ลูกศร') — ถ้ามีระยะทางบันทึกไว้ ก็ยังโชว์ไว้เฉยๆ
    dirCell = u.distance ? ('ระยะทาง ' + u.distance + ' ' + (u.unit || 'กม.')) : '-';
  }
  // โชว์ไซส์ป้ายของตัวเองไว้ในตารางด้วย เพราะเลือกแยกต่อป้ายได้แล้ว (จุดเดียวกันมีคนละไซส์ได้)
  var sizeLabel = SIGNAGE_LABELS_[u.typeKey || 'guerrilla'] || (u.typeKey || 'guerrilla');
  var variantCell = sizeLabel + '\n' + (VARIANT_LABELS_[u.variant] || u.variant || '-') + (u.frame ? '\n⚠ ต้องทำโครงค้ำ' : '');
  var noteCell = u.dirText || '';
  if (u.detail) noteCell = (noteCell ? noteCell + '\n' : '') + 'หมายเหตุ: ' + u.detail;
  if (!noteCell) noteCell = '-';
  return [String(uIdx + 1), variantCell, dirCell, noteCell, coordsDisplay_(u)];
}

// วาดรูปจริงของจุด (ด้านบน) + ตารางรายละเอียดป้ายเต็มความกว้าง (ด้านล่าง) ให้กับสไลด์ 1 จุดติดป้าย
// ความสูงตาราง/รูป ปรับตามจำนวนแถว (ป้าย) อัตโนมัติ — จุดที่มีหลายป้ายจะได้พื้นที่ตารางมากขึ้น รูปเล็กลงบ้าง
function drawPointPhotoTable_(slide, photoBlob, placeholderMsg, rows, notesText) {
  var X = 0.34, W = 9.32, AREA_TOP = 0.75, AREA_BOTTOM = 4.60;
  var y = AREA_TOP;
  if (notesText) {
    var ntb = slide.insertTextBox('หมายเหตุ (จุดนี้): ' + notesText, pptxIn_(X), pptxIn_(y), pptxIn_(W), pptxIn_(0.28));
    styleTextBox_(ntb, { fontSize: 9, italic: true, color: '#7A756C', fontFace: PPTX_FONT });
    y += 0.32;
  }
  var rowsCount = rows.length + 1; // +1 = แถวหัวตาราง
  var tableH = Math.max(0.7, Math.min(1.9, 0.32 * rowsCount));
  var gap = 0.1;
  var photoH = AREA_BOTTOM - y - gap - tableH;
  if (photoH < 1.2) { photoH = 1.2; tableH = AREA_BOTTOM - y - gap - photoH; } // กันรูปเล็กจนเกินไปถ้าป้ายเยอะมาก
  if (photoBlob) insertContain_(slide, photoBlob, X, y, W, photoH);
  else placeholder_(slide, X, y, W, photoH, placeholderMsg);
  var tableY = y + photoH + gap;
  navyTable_(slide, X, tableY, W, tableH, ['ป้ายที่', 'รูปแบบ', 'ทิศทาง/ระยะ', 'ข้อความบอกทาง', 'พิกัด'], rows, [0.55, 1.7, 2.35, 2.9, 1.82]);
}

function coordsDisplay_(obj) {
  if (obj && obj.lat != null && obj.lat !== '' && obj.lng != null && obj.lng !== '') {
    var lat = parseFloat(obj.lat), lng = parseFloat(obj.lng);
    if (!isNaN(lat) && !isNaN(lng)) return lat.toFixed(5) + ', ' + lng.toFixed(5);
  }
  var raw = (obj && obj.coords) ? String(obj.coords).trim() : '';
  if (!raw) return '-';
  var cm = /^(-?\d{1,3}\.\d+)\s*,\s*(-?\d{1,3}\.\d+)$/.exec(raw);
  if (cm) return parseFloat(cm[1]).toFixed(5) + ', ' + parseFloat(cm[2]).toFixed(5);
  return raw; // แยกพิกัดจากข้อความไม่ได้ — โชว์ข้อความดิบไว้ตรงๆ ดีกว่าเดาตัวเลขผิด
}

function insertContain_(slide, blob, x, y, maxW, maxH) {
  var img = slide.insertImage(blob);
  var iw = img.getWidth(), ih = img.getHeight();
  if (!iw || !ih) { img.setLeft(pptxIn_(x)).setTop(pptxIn_(y)).setWidth(pptxIn_(maxW)).setHeight(pptxIn_(maxH)); return img; }
  var scale = Math.min(pptxIn_(maxW) / iw, pptxIn_(maxH) / ih);
  var w = iw * scale, h = ih * scale;
  img.setLeft(pptxIn_(x) + (pptxIn_(maxW) - w) / 2);
  img.setTop(pptxIn_(y) + (pptxIn_(maxH) - h) / 2);
  img.setWidth(w);
  img.setHeight(h);
  return img;
}

// ---------- Main entry point called from the web page ----------
// Folder that holds every generated deck, shared view-access with the whole
// cjmart.co.th domain so any teammate who gets the link can open it (same
// domain-restricted model as the rest of this tool — no public access).
function getDecksFolder_() {
  var props = PropertiesService.getScriptProperties();
  var folderId = props.getProperty('DECKS_FOLDER_ID');
  var folder = null;
  if (folderId) {
    try { folder = DriveApp.getFolderById(folderId); } catch (e) { folderId = null; }
  }
  if (!folderId) {
    folder = DriveApp.createFolder('CJX PackGO — สไลด์ที่สร้างไว้');
    try { folder.setSharing(DriveApp.Access.DOMAIN, DriveApp.Permission.EDIT); } catch (e) { /* sharing best-effort */ }
    props.setProperty('DECKS_FOLDER_ID', folder.getId());
  }
  return folder;
}

function withRetry_(fn) {
  var lastErr;
  for (var i = 0; i < 6; i++) {
    try {
      return fn();
    } catch (e) {
      lastErr = e;
      var msg = (e && e.message) ? e.message : String(e);
      if (msg.indexOf('has no text') === -1 && msg.indexOf('has no fill') === -1 && msg.indexOf('has no border') === -1) throw e;
      Utilities.sleep(150 + i * 120);
    }
  }
  throw lastErr;
}

function addShape_(slide, shapeType, x, y, w, h, opts) {
  opts = opts || {};
  var shp = slide.insertShape(shapeType, pptxIn_(x), pptxIn_(y), pptxIn_(w), pptxIn_(h));
  withRetry_(function () {
    if (opts.fill) shp.getFill().setSolidFill(opts.fill);
    else shp.getFill().setTransparent();
  });
  if (opts.borderColor) {
    try {
      withRetry_(function () {
        shp.getBorder().getLineFill().setSolidFill(opts.borderColor);
        shp.getBorder().setWeight(opts.borderWeight || 1);
        if (opts.dash) shp.getBorder().setDashStyle(SlidesApp.DashStyle.DASH);
      });
    } catch (e) { /* border styling best-effort */ }
  } else {
    try { withRetry_(function () { shp.getBorder().setTransparent(); }); } catch (e) {}
  }
  return shp;
}

function styleTextBox_(tb, opts) {
  opts = opts || {};
  withRetry_(function () {
    var tr = tb.getText();
    // A textbox with literally zero characters has no paragraph/style to fetch —
    // Slides throws "has no text" here every single time (not a timing issue),
    // so skip text-level styling entirely when there's nothing to style.
    if (tr && tr.asString().length > 0) {
      var style = tr.getTextStyle();
      if (opts.fontSize) style.setFontSize(opts.fontSize);
      if (opts.color) style.setForegroundColor(opts.color);
      if (opts.bold) style.setBold(true);
      if (opts.italic) style.setItalic(true);
      style.setFontFamily(opts.fontFace || PPTX_FONT);
      if (opts.align) tr.getParagraphStyle().setParagraphAlignment(opts.align);
    }
    if (opts.valign) tb.setContentAlignment(opts.valign);
  });
}

// paragraphs: array of paragraphs, each an array of runs {text,bold,italic,fontSize,color,fontFace}
function setRichText_(tb, paragraphs, commonOpts) {
  commonOpts = commonOpts || {};
  var full = paragraphs.map(function (p) { return p.map(function (r) { return r.text; }).join(''); }).join('\n');
  withRetry_(function () {
    var tr = tb.getText();
    tr.setText(full);
    var offset = 0;
    paragraphs.forEach(function (runs) {
      runs.forEach(function (r) {
        var len = (r.text || '').length;
        if (len > 0) {
          var range = tr.getRange(offset, offset + len);
          var style = range.getTextStyle();
          style.setFontFamily(r.fontFace || commonOpts.fontFace || PPTX_FONT);
          style.setFontSize(r.fontSize || commonOpts.fontSize || 10);
          style.setForegroundColor(r.color || commonOpts.color || PPTX_BLACK);
          if (r.bold) style.setBold(true);
          if (r.italic) style.setItalic(true);
        }
        offset += len;
      });
      offset += 1; // the '\n' joining paragraphs
    });
  });
}

function navyTable_(slide, x, y, w, h, header, rows, colWIn) {
  var nCols = header.length;
  var nRows = rows.length + 1;
  var rowH = h / nRows;
  var colW;
  if (colWIn && colWIn.length === nCols) {
    var sum = 0;
    for (var i = 0; i < colWIn.length; i++) sum += colWIn[i];
    colW = colWIn.map(function (cw) { return (cw / sum) * w; });
  } else {
    colW = header.map(function () { return w / nCols; });
  }
  var colX = [];
  var acc = x;
  for (var ci = 0; ci < nCols; ci++) { colX.push(acc); acc += colW[ci]; }

  function drawRow(rowIdx, cells, isHeader) {
    var rowY = y + rowIdx * rowH;
    for (var c = 0; c < nCols; c++) {
      var cx = colX[c], cw = colW[c];
      addShape_(slide, SlidesApp.ShapeType.RECTANGLE, cx, rowY, cw, rowH, {
        fill: isHeader ? PPTX_NAVY : PPTX_WHITE,
        borderColor: '#CDD4EA',
        borderWeight: 0.75
      });
      var cellText = cells[c];
      if (cellText === '' || cellText === null || cellText === undefined) cellText = '-';
      var tb = slide.insertTextBox(String(cellText), pptxIn_(cx + 0.05), pptxIn_(rowY + 0.03), pptxIn_(cw - 0.1), pptxIn_(rowH - 0.06));
      styleTextBox_(tb, {
        fontSize: isHeader ? 10 : 9.5,
        bold: !!isHeader,
        color: isHeader ? PPTX_WHITE : PPTX_BLACK,
        fontFace: PPTX_FONT,
        valign: SlidesApp.ContentAlignment.MIDDLE
      });
    }
  }

  drawRow(0, header, true);
  for (var r = 0; r < rows.length; r++) drawRow(r + 1, rows[r], false);
}

// เลือกไซส์ป้ายแยกต่อป้าย (unit) ได้แล้ว (จุดเดียวกันมีคนละไซส์ได้) เลยนับตามไซส์จริงของแต่ละป้ายเอง
// ไม่ใช้ s.typeKey ระดับจุดอีกต่อไป (เก็บ fallback ไว้เผื่อข้อมูลเก่ามาก ๆ ที่ยังไม่ผ่านการ migrate ฝั่งหน้าเว็บ)
function computeSignageCounts_(signages) {
  var counts = {};
  (signages || []).forEach(function (s) {
    var units = (s.units && s.units.length) ? s.units : [{ typeKey: s.typeKey || 'guerrilla' }];
    units.forEach(function (u) {
      var tk = u.typeKey || s.typeKey || 'guerrilla';
      var baseLabel = SIGNAGE_LABELS_[tk] || tk;
      // ป้ายกองโจร แยกนับตามวิธีติดตั้ง — ปักเสาไฟ vs. โครงค้ำ
      var label = (tk === 'guerrilla' && u.frame) ? baseLabel + ' (โครงค้ำ)' : baseLabel;
      counts[label] = (counts[label] || 0) + 1;
    });
  });
  var banner = counts[SIGNAGE_LABELS_.banner] || 0;
  var guerrilla = (counts[SIGNAGE_LABELS_.guerrilla] || 0) + (counts[SIGNAGE_LABELS_.guerrilla + ' (โครงค้ำ)'] || 0) + (counts[SIGNAGE_LABELS_.square] || 0);
  var total = 0;
  Object.keys(counts).forEach(function (k) { total += counts[k]; });
  return { counts: counts, banner: banner, guerrilla: guerrilla, total: total };
}

function createPackGoSlides(jsonStr) {
  var data = JSON.parse(jsonStr);
  var deckTitle = 'CJX PackGO — ' + (data.branchName || 'ไม่ระบุชื่อสาขา');
  var pres = SlidesApp.create(deckTitle);
  var presId = pres.getId();
  {
    var initialSlide = pres.getSlides()[0];
    var logoBlob = Utilities.newBlob(Utilities.base64Decode(PPTX_LOGO_B64), 'image/png');
    var bannerBlob = Utilities.newBlob(Utilities.base64Decode(PPTX_BANNER_B64), 'image/png');

    var openStartFmt = fmtShort_(data.openStart);
    var openEndFmt = fmtShort_(data.openEnd);
    var sc = computeSignageCounts_(data.signages);

    // ---- Cover ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 0, 0, PPTX_SLIDE_W, PPTX_SLIDE_H, { fill: PPTX_GOLD_BAR });
      addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 3.8, 0, PPTX_SLIDE_W - 3.8, PPTX_SLIDE_H, { fill: PPTX_WHITE });
      slide.insertImage(logoBlob, pptxIn_(0.25), pptxIn_(0.2), pptxIn_(0.7), pptxIn_(0.6));
      var t1 = slide.insertTextBox('สื่อประชาสัมพันธ์', pptxIn_(4.0), pptxIn_(0.45), pptxIn_(5.7), pptxIn_(0.85));
      styleTextBox_(t1, { fontSize: 32, bold: true, color: PPTX_BLACK, fontFace: PPTX_FONT, align: SlidesApp.ParagraphAlignment.CENTER, valign: SlidesApp.ContentAlignment.MIDDLE });
      var t2 = slide.insertTextBox('', pptxIn_(4.0), pptxIn_(1.5), pptxIn_(5.7), pptxIn_(1.6));
      setRichText_(t2, [
        [{ text: 'CJXสาขา: ' + (data.branchName || '-'), bold: true, fontSize: 15 }],
        [{ text: 'วันเปิดสาขา: ' + openStartFmt + ' - ' + openEndFmt, fontSize: 13 }],
        [{ text: 'รหัสสาขา: ' + (data.branchCode || '-'), fontSize: 13 }],
        [{ text: 'จังหวัด: ' + (data.province || '-'), fontSize: 13 }]
      ], { color: PPTX_BLACK, fontFace: PPTX_FONT });
      withRetry_(function () { t2.getText().getParagraphStyle().setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER); });
      t2.setContentAlignment(SlidesApp.ContentAlignment.TOP);
      slide.insertImage(bannerBlob, pptxIn_(3.95), pptxIn_(3.15), pptxIn_(5.8), pptxIn_(1.95));
    })();

    // ---- Branch info ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, 'ข้อมูลของ สาขา' + (data.branchName || ''));
      placeholder_(slide, 0.34, 0.85, 4.35, 3.9, 'แนบรูปด้านหน้าสาขา\n(Timemark)');
      var info = [
        ['ชื่อสาขา', data.branchName || '-'],
        ['พิกัดสาขา', data.coords || '-'],
        ['ที่อยู่สาขา', data.address || '-'],
        ['ผู้รับผิดชอบ', data.responsible || '-'],
        ['ทีมกิจกรรม', data.activityTeam || '-'],
        ['แนะนำเวลาเปิด-ปิดร้าน', data.storeHours || '-']
      ];
      var y = 0.95;
      info.forEach(function (pair) {
        var tb = slide.insertTextBox('', pptxIn_(4.95), pptxIn_(y), pptxIn_(4.8), pptxIn_(0.5));
        setRichText_(tb, [[
          { text: pair[0] + ' : ', bold: true, color: PPTX_BLACK, fontSize: 11.5 },
          { text: pair[1], color: '#555555', fontSize: 11.5 }
        ]], { fontFace: PPTX_FONT });
        y += 0.55;
      });
    })();

    // ---- PR plan ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, '1. แผนงานประชาสัมพันธ์ก่อนเปิดสาขา');
      placeholder_(slide, 0.34, 0.85, 5.4, 3.9, 'แนบภาพแผนที่แบ่งโซน\n(จาก SA)');
      var items = [
        'เปิดคลิปเสียง และโฟนประชาสัมพันธ์เน้นย้ำวันเปิดสาขาและโปรโมชั่นหน้าสาขา',
        'ติดสื่อป้ายแบรนเนอร์ตามร้านค้าชุมชนในพื้นที่ ' + sc.banner + ' ผืน ป้ายกองโจร ' + sc.guerrilla + ' จุด รวม ' + sc.total + ' ป้าย',
        'ขับรถโฟนประชาสัมพันธ์ใช้เสียงในพื้นที่โดยรอบสาขาในพื้นที่สังเขป',
        'ประชาสัมพันธ์แจกใบปลิวโปรโมชั่นเปิดร้านในจุดรวมพล/สถานที่ราชการ/หน้าโรงงานต่างๆ',
        'ช่วงเย็นของ D-1 โฟนประชาสัมพันธ์ด้านหน้าสาขาอีกครั้งเพื่อเน้นย้ำกิจกรรม'
      ];
      var tb = slide.insertTextBox('', pptxIn_(5.95), pptxIn_(0.85), pptxIn_(3.75), pptxIn_(3.9));
      setRichText_(tb, items.map(function (t) { return [{ text: t, fontSize: 10 }]; }), { color: PPTX_BLACK, fontFace: PPTX_FONT });
      try { tb.getText().getListStyle().applyListPreset(SlidesApp.ListPreset.DISC_CIRCLE_SQUARE); } catch (e) {}
      tb.setContentAlignment(SlidesApp.ContentAlignment.TOP);
    })();

    // ---- Zone division ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, '2. แบ่งโซนประชาสัมพันธ์');
      placeholder_(slide, 0.34, 0.85, 9.3, 3.9, 'แนบภาพแผนที่แบ่งโซนประชาสัมพันธ์ (จาก SA)');
    })();

    // ---- Day-by-day schedule ----
    (data.dayPlans || []).forEach(function (day) {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, '3. ตารางแผนงานประชาสัมพันธ์รายวัน ' + day.label, 18);
      var rows = (day.rows || []).filter(function (r) { return r.timeStart || r.timeEnd || r.detail; }).map(function (r) {
        var timeDisplay = (r.timeStart && r.timeEnd) ? (r.timeStart + '-' + r.timeEnd) : (r.timeStart || r.timeEnd || '-');
        var flyersRaw = String(r.flyers || '').trim();
        var flyersDisplay = flyersRaw ? (/^\d+$/.test(flyersRaw) ? flyersRaw + ' ใบ' : flyersRaw) : '-';
        var coordsDisplay = (r.lat && r.lng) ? (parseFloat(r.lat).toFixed(5) + ', ' + parseFloat(r.lng).toFixed(5)) : '-';
        return [timeDisplay, r.detail || '-', r.manpower || '-', flyersDisplay, coordsDisplay];
      });
      navyTable_(slide, 0.34, 0.85, 9.3, 3.9, ['เวลา', 'รายละเอียด', 'กำลังคน', 'ใบปลิว', 'พิกัด'], rows.length ? rows : [['-', '-', '-', '-', '-']], [1.0, 4.1, 0.9, 1.0, 2.3]);
    });

    // ---- Signage points: overview/summary table (จุดที่/รายละเอียด/พิกัด/จำนวน) ----
    // เพิ่มตามฟีดแบคทีม — อยากได้ตารางสรุปภาพรวมทุกจุดในหน้าเดียว (เห็นว่าทำป้ายอะไรบ้าง) ก่อนจะไปดู
    // สไลด์รายละเอียดของแต่ละจุดที่มีอยู่แล้วด้านหลัง — ไม่ได้แทนที่สไลด์รายละเอียดเดิม แค่เพิ่มเป็นหน้าสรุปนำ
    (function () {
      function overviewDetail_(label, units) {
        var variantSet = {}, variantList = [];
        units.forEach(function (u) {
          var v = u.variant ? (VARIANT_LABELS_[u.variant] || u.variant) : null;
          if (v && !variantSet[v]) { variantSet[v] = true; variantList.push(v); }
        });
        return variantList.length ? (label + ' (' + variantList.join(' + ') + ')') : label;
      }
      function overviewCoords_(units) {
        for (var i = 0; i < units.length; i++) {
          var d = coordsDisplay_(units[i]);
          if (d && d !== '-') return d;
        }
        return '-';
      }
      var overviewRows = (data.signages || []).map(function (s, idx) {
        var units = (s.units && s.units.length) ? s.units : [{ coords: s.coords || '', typeKey: s.typeKey || 'guerrilla' }];
        var label = pointTypeLabel_(units);
        return [String(idx + 1), overviewDetail_(label, units), overviewCoords_(units), units.length + ' ป้าย'];
      });
      if (!overviewRows.length) return;
      var ROWS_PER_SLIDE = 14; // กันแถวเบียดกันเกินไปถ้าจุดติดป้ายเยอะ — แบ่งเป็นหลายสไลด์แทน
      var pageCount = Math.ceil(overviewRows.length / ROWS_PER_SLIDE);
      for (var p = 0; p < pageCount; p++) {
        var pageRows = overviewRows.slice(p * ROWS_PER_SLIDE, (p + 1) * ROWS_PER_SLIDE);
        var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
        chrome_(slide, null, logoBlob);
        title_(slide, 'สรุปจุดติดตั้งป้ายทั้งหมด' + (pageCount > 1 ? ' (' + (p + 1) + '/' + pageCount + ')' : ''), 18);
        navyTable_(slide, 0.34, 0.85, 9.3, 3.9, ['จุดที่', 'รายละเอียด', 'พิกัด', 'จำนวน'], pageRows, [0.7, 5.0, 2.6, 1.0]);
      }
    })();

    // ---- Signage points ----
    (data.signages || []).forEach(function (s, idx) {
      var units = (s.units && s.units.length) ? s.units : [{ detail: s.detail || '', coords: s.coords || '', photo: s.photo || '', typeKey: s.typeKey || 'guerrilla' }];
      var label = pointTypeLabel_(units);

      // จุดเดียวกัน (s) = สถานที่เดียวกันเสมอ -> รวมทุกป้ายในจุดนี้เป็นสไลด์เดียวเสมอ
      // รูปที่โชว์: ใช้ภาพคอมโพสิตจากฝั่งหน้าเว็บก่อน (s.comboGroups[0].photo — เห็นทุกป้ายซ้อนอยู่บนรูปเดียวกัน
      // ตามตำแหน่งที่วางไว้จริง) ถ้าไม่มี (เช่นยังไม่มีรูปสถานที่เลย) ค่อย fallback ไปใช้รูปของป้ายใดป้ายหนึ่ง
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      var qty = units.length || s.qty || 1;
      title_(slide, 'จุดที่ ' + (idx + 1) + ' ' + label + ' จำนวน ' + qty + ' ป้าย', 16);

      var photoSrc = (s.comboGroups && s.comboGroups[0] && s.comboGroups[0].photo) ? s.comboGroups[0].photo : null;
      if (!photoSrc) {
        for (var pi = 0; pi < units.length; pi++) {
          if (units[pi].photo && /^data:image\//.test(units[pi].photo)) { photoSrc = units[pi].photo; break; }
        }
      }
      var photoBlob = (photoSrc && /^data:image\//.test(photoSrc)) ? dataUrlToBlob_(photoSrc) : null;
      var rows = units.map(function (u, uIdx) { return buildUnitTableRow_(u, uIdx); });
      drawPointPhotoTable_(slide, photoBlob, 'แนบรูปจริงของจุด (Timemark)', rows, s.notes);
    });

    // ---- Hotels / accommodation ----
    (data.hotels || []).forEach(function (h, hIdx) {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, 'โรงแรม/ที่พัก ' + (hIdx + 1) + (h.name ? ' — ' + h.name : ''), 16);

      var photoBlob = (h.photo && /^data:image\//.test(h.photo)) ? dataUrlToBlob_(h.photo) : null;
      if (photoBlob) insertContain_(slide, photoBlob, 0.34, 0.75, 6.4, 3.9);
      else placeholder_(slide, 0.34, 0.75, 6.4, 3.9, 'แนบรูปโรงแรม (ถ้ามี)');

      var coordsDisplay = coordsDisplay_(h);
      var lines = [];
      lines.push('ชื่อ: ' + (h.name || '-'));
      lines.push('เบอร์โทร: ' + (h.phone || '-'));
      if (h.pricePerNight) lines.push('ราคาต่อคืน: ' + h.pricePerNight);
      if (h.capacity) lines.push('ต่อ: ' + h.capacity);
      lines.push('พิกัด: ' + coordsDisplay);
      if (h.notes) lines.push('หมายเหตุ: ' + h.notes);
      goldCard_(slide, 6.9, 0.75, 2.85, 3.9, 'รายละเอียดที่พัก', lines);
    });

    // ---- Employee parking ----
    (data.parkings || []).forEach(function (p, pIdx) {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, 'ที่จอดรถสำหรับพนักงาน ' + (pIdx + 1), 16);

      var photoBlob = (p.photo && /^data:image\//.test(p.photo)) ? dataUrlToBlob_(p.photo) : null;
      if (photoBlob) insertContain_(slide, photoBlob, 0.34, 0.75, 6.4, 3.9);
      else placeholder_(slide, 0.34, 0.75, 6.4, 3.9, 'แนบรูปที่จอดรถ (ถ้ามี)');

      var coordsDisplay = coordsDisplay_(p);
      var lines = [];
      lines.push('มอเตอร์ไซค์: ' + (p.motorcycleCount || '-') + ' คัน');
      lines.push('รถยนต์: ' + (p.carCount || '-') + ' คัน');
      lines.push('พิกัด: ' + coordsDisplay);
      if (p.notes) lines.push('หมายเหตุ: ' + p.notes);
      goldCard_(slide, 6.9, 0.75, 2.85, 3.9, 'รายละเอียดที่จอดรถ', lines);
    });

    // ---- Activity + help (+ optional floor-plan layout with symbol markers) ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, 'กิจกรรมหน้าร้าน และ ขอความช่วยเหลือ', 18);
      var activityLines = String(data.activityDetail || '-').split(/[,\n]/).map(function (s) { return s.trim(); }).filter(Boolean);
      var helpLines = (data.helpItems || []).map(function (h) { return h.name + ' — ' + h.qty; });

      var layout = data.activityLayout;
      if (layout && layout.compositedPhoto) {
        var photoBlob = (/^data:image\//.test(layout.compositedPhoto)) ? dataUrlToBlob_(layout.compositedPhoto) : null;
        var legendLines = (layout.markers || []).map(function (m) {
          var glyph = m.symbol === 'star' ? '★' : m.symbol === 'heart' ? '♥' : m.symbol === 'square' ? '■' : m.symbol === 'rect' ? '▬' : m.symbol === 'triangle' ? '▲' : '●';
          var tag = m.label ? (glyph + ' ' + m.label) : glyph;
          return tag + (m.desc ? ': ' + m.desc : '');
        });
        var helpAndLegend = helpLines.slice();
        if (legendLines.length) {
          if (helpAndLegend.length) helpAndLegend.push('');
          helpAndLegend.push('สัญลักษณ์บนผัง:');
          helpAndLegend = helpAndLegend.concat(legendLines);
        }

        if (layout.slideLayout === 'left') {
          if (photoBlob) insertContain_(slide, photoBlob, 0.34, 0.75, 5.9, 3.9);
          else placeholder_(slide, 0.34, 0.75, 5.9, 3.9, 'ผัง Layout');
          goldCard_(slide, 6.4, 0.75, 3.26, 1.9, 'กิจกรรม', activityLines.length ? activityLines : ['-'], 8.5);
          goldCard_(slide, 6.4, 2.75, 3.26, 1.9, 'ขอความช่วยเหลือ', helpAndLegend.length ? helpAndLegend : ['-'], 7.5);
        } else {
          if (photoBlob) insertContain_(slide, photoBlob, 0.34, 0.75, 9.32, 2.25);
          else placeholder_(slide, 0.34, 0.75, 9.32, 2.25, 'ผัง Layout');
          goldCard_(slide, 0.34, 3.15, 4.6, 1.5, 'กิจกรรม', activityLines.length ? activityLines : ['-'], 8.5);
          goldCard_(slide, 5.06, 3.15, 4.6, 1.5, 'ขอความช่วยเหลือ', helpAndLegend.length ? helpAndLegend : ['-'], 7.5);
        }
      } else {
        goldCard_(slide, 0.34, 0.85, 4.4, 3.9, 'กิจกรรม', activityLines.length ? activityLines : ['-']);
        goldCard_(slide, 5.05, 0.85, 4.6, 3.9, 'ขอความช่วยเหลือ', helpLines.length ? helpLines : ['-']);
      }
    })();

    // ---- Summary MKT + purchasing ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      chrome_(slide, null, logoBlob);
      title_(slide, 'สรุปสำหรับ MKT + จัดซื้อ', 18);
      var rows = [];
      Object.keys(sc.counts).forEach(function (label) { rows.push([label, sc.counts[label], '', '']); });
      rows.push(['รวม', sc.total, '', '']);
      navyTable_(slide, 0.34, 0.85, 4.8, 2.0, ['รายการป้าย', 'จำนวน', 'ราคา/ป้าย', 'ราคารวม'], rows, [1.9, 0.9, 1.0, 1.0]);
      goldCard_(slide, 0.34, 3.0, 4.8, 1.7, data.branchName || '-', [
        'ติดตั้งวันที่: ' + fmtShort_(data.installDate),
        'รื้อถอนวันที่: ' + fmtShort_(data.removalDate),
        'พิกัดสาขา: ' + (data.coords || '-'),
        'ที่อยู่สาขา: ' + (data.address || '-')
      ]);
      addShape_(slide, SlidesApp.ShapeType.ROUND_RECTANGLE, 5.35, 0.85, 4.3, 3.85, { fill: '#FFF6E6', borderColor: '#C77D00', borderWeight: 1 });
      var tb = slide.insertTextBox('', pptxIn_(5.55), pptxIn_(1.0), pptxIn_(3.95), pptxIn_(3.6));
      setRichText_(tb, [
        [{ text: 'ป้าย Sup จัดซื้อ', bold: true, fontSize: 11 }],
        [{ text: 'ซัพป้ายที่แนะนำ: ' + (data.purchasingContact || '(หากมี)'), fontSize: 10 }],
        [{ text: 'ซัพอื่นๆที่แนะนำ: ' + (data.otherSuppliers || '(หากมี)'), fontSize: 10 }],
        [{ text: '', fontSize: 10 }],
        [{ text: 'ติดตั้งในคืนวันที่ ' + fmtShort_(data.installDate), fontSize: 10 }],
        [{ text: 'เก็บในคืนวันที่ ' + fmtShort_(data.removalDate), fontSize: 10 }],
        [{ text: '', fontSize: 10 }],
        [{ text: 'ต้องการ Artwork ภายในวันที่: ' + fmtShort_(data.artworkDeadline), bold: true, fontSize: 10 }]
      ], { color: PPTX_BLACK, fontFace: PPTX_FONT });
      tb.setContentAlignment(SlidesApp.ContentAlignment.TOP);
    })();

    // ---- Thank you ----
    (function () {
      var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
      addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 0, 0, PPTX_SLIDE_W, PPTX_BAR_H, { fill: PPTX_GOLD_BAR });
      addShape_(slide, SlidesApp.ShapeType.RECTANGLE, 0, PPTX_SLIDE_H - PPTX_BAR_H, PPTX_SLIDE_W, PPTX_BAR_H, { fill: PPTX_GOLD_BAR });
      slide.insertImage(logoBlob, pptxIn_(0.3), pptxIn_(0.3), pptxIn_(0.7), pptxIn_(0.6));
      var tb = slide.insertTextBox('THANK YOU', pptxIn_(0), pptxIn_(1.7), pptxIn_(10), pptxIn_(1.2));
      styleTextBox_(tb, { fontSize: 44, bold: true, color: PPTX_BLACK, fontFace: PPTX_FONT, align: SlidesApp.ParagraphAlignment.CENTER });
      slide.insertImage(bannerBlob, pptxIn_(2.2), pptxIn_(3.2), pptxIn_(5.6), pptxIn_(1.9));
    })();

    initialSlide.remove();
    pres.saveAndClose();

    try {
      var file = DriveApp.getFileById(presId);
      var folder = getDecksFolder_();
      file.moveTo(folder);
    } catch (e) { /* if this fails the file just stays in the script owner's Drive root — still usable */ }

    return {
      url: 'https://docs.google.com/presentation/d/' + presId + '/edit',
      title: deckTitle
    };
  }
}


